{
  "name": "@athlya/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Athlya member-facing web app (Next.js 16 + React 19 + Tailwind 4)",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:release": "playwright test --config e2e/release.config.ts",
    "e2e:install": "playwright install chromium",
    "lighthouse": "node scripts/lighthouse-check.js",
    "clean": "rimraf .next .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@athlya/shared": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@athlya/eslint-config": "workspace:*",
    "@athlya/tsconfig": "workspace:*",
    "@axe-core/playwright": "^4.14.0",
    "@opennextjs/cloudflare": "1.20.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.30",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
