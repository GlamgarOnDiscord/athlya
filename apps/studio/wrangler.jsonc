// Cloudflare Worker for @athlya/studio built by OpenNext (issue #422).
//   pnpm --filter @athlya/studio build:worker      # next build + OpenNext bundle
//   pnpm --filter @athlya/studio exec wrangler deploy --env <staging|production>
// NEXT_PUBLIC_* values are inlined at build time: build once per environment.
// Custom domains / routes are attached in the Cloudflare dashboard (runbook
// docs/runbooks/deploy-frontend.md), not here, so a dry-run needs no zone.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "athlya-studio-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "env": {
    "staging": {
      "name": "athlya-studio-staging",
      "vars": { "APP_ENV": "staging" },
    },
    "production": {
      "name": "athlya-studio",
      "vars": { "APP_ENV": "production" },
    },
  },
}
