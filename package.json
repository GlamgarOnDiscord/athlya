{
  "name": "athlya",
  "version": "1.0.0",
  "private": true,
  "description": "Athlya — open-source, multi-tenant, RGPD-first fitness platform",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.18.1 <21",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "build:ci": "cross-env SKIP_ENV_VALIDATION=1 pnpm build",
    "preflight": "pnpm install --frozen-lockfile && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build:ci",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || exit 0",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "seed:all": "node packages/db/scripts/migrate.mjs && node packages/db/scripts/seed-dev.mjs && node packages/db/scripts/seed-classes.mjs",
    "check:dead": "knip --exclude duplicates",
    "check:overrides": "node scripts/check-overrides.mjs",
    "check:legal": "node scripts/check-legal-placeholders.mjs",
    "check:labels": "node scripts/check-labels.mjs",
    "check:docs": "node scripts/check-docs-drift.mjs"
  },
  "devDependencies": {
    "@athlya/eslint-config": "workspace:*",
    "@athlya/prettier-config": "workspace:*",
    "@athlya/tsconfig": "workspace:*",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "knip": "^6.26.0",
    "prettier": "^3.9.5",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "prettier": "@athlya/prettier-config",
  "dependencies": {
    "postcss": "^8.5.19"
  },
  "pnpm": {
    "overrides": {
      "dockerode>uuid": "11.1.1",
      "testcontainers>tmp": "^0.2.6",
      "@grpc/grpc-js": ">=1.14.4",
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.10",
      "js-yaml": ">=4.2.0",
      "@babel/core": ">=7.29.6",
      "@sentry/cli>undici": "6.27.0",
      "testcontainers>undici": "^7",
      "jsdom>ws": "^8.21.0"
    }
  }
}
