{
  "name": "athlya",
  "version": "1.0.0",
  "private": true,
  "description": "Athlya — open-source, multi-tenant, RGPD-first fitness platform",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20 <21",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "seed:all": "node packages/db/scripts/migrate.mjs && node packages/db/scripts/seed-dev.mjs && node packages/db/scripts/seed-classes.mjs",
    "check:dead": "knip --exclude duplicates",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status"
  },
  "devDependencies": {
    "@athlya/eslint-config": "workspace:*",
    "@athlya/prettier-config": "workspace:*",
    "@athlya/tsconfig": "workspace:*",
    "@changesets/cli": "^2.31.0",
    "eslint": "^9.39.1",
    "knip": "^6.15.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3"
  },
  "prettier": "@athlya/prettier-config",
  "dependencies": {
    "postcss": "^8.5.15"
  },
  "pnpm": {
    "overrides": {
      "miniflare>ws": "8.20.1",
      "dockerode>uuid": "11.1.1",
      "testcontainers>tmp": "^0.2.6"
    }
  }
}
