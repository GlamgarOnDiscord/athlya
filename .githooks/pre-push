#!/usr/bin/env sh
# Mirror the required CI gate ("Lint, typecheck, and tests") locally so a
# red check is caught before the push instead of after a ~5 min CI round-trip.
#
# Runs `pnpm preflight`: frozen-lockfile install + prettier --check + lint +
# typecheck + test + build:ci (Docker-gated suites auto-skip without Docker).
# Behind a TLS-intercepting proxy, push with TURBO_ENV_MODE=loose so
# NODE_EXTRA_CA_CERTS reaches the tasks.
#
# Wired via `git config core.hooksPath .githooks` (set by the root
# package.json `prepare` script on every `pnpm install`).

echo "▶ pre-push: running pnpm preflight (frozen install + format:check + lint + typecheck + test + build)…"
if ! pnpm preflight; then
  echo "✖ preflight failed — fix locally (try \`pnpm format\`) before pushing, or \`git push --no-verify\` to bypass." >&2
  exit 1
fi
echo "✔ preflight passed."
