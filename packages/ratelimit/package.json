{
  "name": "@athlya/ratelimit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Athlya sliding-window rate limiter primitive — Upstash-backed, framework-free. Extracted from @athlya/api in hardening H5 to break the @athlya/api ↔ @athlya/auth dependency cycle.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./sliding-window": {
      "types": "./src/sliding-window.ts",
      "default": "./src/sliding-window.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0"
  },
  "devDependencies": {
    "@athlya/eslint-config": "workspace:*",
    "@athlya/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
