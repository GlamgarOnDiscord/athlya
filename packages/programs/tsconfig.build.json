{
  // Emit-only project used by `pnpm build`: `src/` without the tests.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": false
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    ".turbo",
    "coverage",
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "vitest.config.ts"
  ]
}
