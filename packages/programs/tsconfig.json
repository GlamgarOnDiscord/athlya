{
  // Editor / IDE / typecheck project for the whole package, tests
  // included. `tsconfig.build.json` narrows it to `src/` for `build`.
  "extends": "@athlya/tsconfig/node.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", ".turbo", "coverage"]
}
