{
  "name": "@athlya/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Authentication primitives for Athlya — password hashing, HIBP breached-password check, JWT signing/verification and QR check-in tokens",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./password": {
      "types": "./src/password.ts",
      "default": "./src/password.ts"
    },
    "./hibp": {
      "types": "./src/hibp.ts",
      "default": "./src/hibp.ts"
    },
    "./jwt": {
      "types": "./src/jwt.ts",
      "default": "./src/jwt.ts"
    },
    "./qr": {
      "types": "./src/qr.ts",
      "default": "./src/qr.ts"
    },
    "./replay-redis": {
      "types": "./src/replay-redis.ts",
      "default": "./src/replay-redis.ts"
    },
    "./throttle": {
      "types": "./src/throttle.ts",
      "default": "./src/throttle.ts"
    },
    "./service": {
      "types": "./src/service.ts",
      "default": "./src/service.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@athlya/ratelimit": "workspace:*",
    "@athlya/shared": "workspace:*",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@athlya/eslint-config": "workspace:*",
    "@athlya/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
