{
  "name": "@athlya/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle ORM schema, migrations, tenant-aware client and repository helpers for the Athlya PostgreSQL database",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./idempotency": {
      "types": "./src/idempotency.ts",
      "default": "./src/idempotency.ts"
    },
    "./outbox": {
      "types": "./src/outbox.ts",
      "default": "./src/outbox.ts"
    },
    "./stripe-webhook-events": {
      "types": "./src/stripe-webhook-events.ts",
      "default": "./src/stripe-webhook-events.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "lint:rls-coverage": "node scripts/lint-rls-coverage.mjs",
    "migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rls": "bash scripts/test-rls.sh",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@athlya/shared": "workspace:*",
    "@neondatabase/serverless": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@athlya/eslint-config": "workspace:*",
    "@athlya/tsconfig": "workspace:*",
    "@electric-sql/pglite": "^0.5.4",
    "@fast-check/vitest": "^0.4.1",
    "@testcontainers/postgresql": "^12.0.3",
    "@types/node": "^20.19.43",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "fast-check": "^3.23.2",
    "rimraf": "^6.0.1",
    "testcontainers": "^12.0.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
