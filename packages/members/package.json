{
  "name": "@athlya/members",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Members domain use cases for Athlya — profile read/update, consent history, RGPD export + deletion cascade, workout session logging",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./service": {
      "types": "./src/service.ts",
      "default": "./src/service.ts"
    },
    "./consents": {
      "types": "./src/consents.ts",
      "default": "./src/consents.ts"
    },
    "./sessions": {
      "types": "./src/sessions.ts",
      "default": "./src/sessions.ts"
    },
    "./export": {
      "types": "./src/export.ts",
      "default": "./src/export.ts"
    },
    "./cascade": {
      "types": "./src/cascade.ts",
      "default": "./src/cascade.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@athlya/shared": "workspace:*"
  },
  "devDependencies": {
    "@athlya/eslint-config": "workspace:*",
    "@athlya/tsconfig": "workspace:*",
    "@electric-sql/pglite": "^0.5.4",
    "@testcontainers/postgresql": "^12.0.3",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "postgres": "^3.4.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
