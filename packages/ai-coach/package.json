{
  "name": "@athlya/ai-coach",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI coach use case for Athlya — minimised training context, Vercel AI SDK structured advice, consent and quota guards",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./service": {
      "types": "./src/service.ts",
      "default": "./src/service.ts"
    },
    "./context": {
      "types": "./src/context.ts",
      "default": "./src/context.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@athlya/members": "workspace:*",
    "@athlya/shared": "workspace:*",
    "ai": "^7.0.143",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@athlya/eslint-config": "workspace:*",
    "@athlya/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
